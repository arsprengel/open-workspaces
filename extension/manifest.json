{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Open Workspaces",
  "description": "__MSG_appDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "sidePanel", "contextMenus", "alarms", "favicon"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+A" },
      "description": "__MSG_cmdSwitch__"
    },
    "move-tab": {
      "suggested_key": { "default": "Alt+T" },
      "description": "__MSG_cmdMoveTab__"
    },
    "new-workspace": {
      "suggested_key": { "default": "Alt+N" },
      "description": "__MSG_cmdNewWorkspace__"
    },
    "toggle-side-panel": {
      "suggested_key": { "default": "Alt+S" },
      "description": "__MSG_cmdSidePanel__"
    },
    "next-workspace": { "description": "__MSG_cmdNext__" },
    "previous-workspace": { "description": "__MSG_cmdPrevious__" },
    "close-workspace": { "description": "__MSG_cmdClose__" },
    "open-dashboard": { "description": "__MSG_cmdDashboard__" }
  }
}
