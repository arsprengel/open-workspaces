  "welcomeTitle": {
    "message": "Welcome to Open Workspaces"
  },
  "welcomeSubtitle": {
    "message": "Organize your tabs into workspaces. Unlimited, free and open source. No account, no tracking, everything stays in your browser."
  },
  "welcomeStep1Title": {
    "message": "Save a window as a workspace"
  },
  "welcomeStep1Text": {
    "message": "Each workspace is a set of tabs. Switching swaps the tabs of your window, and everything is saved automatically."
  },
  "welcomeStep2Title": {
    "message": "Switch with Alt+A"
  },
  "welcomeStep2Text": {
    "message": "Open the quick switcher, type to search across workspaces, tabs and resources, press Enter. Alt+T moves the current tab."
  },
  "welcomeStep3Title": {
    "message": "Keep resources, notes and tasks"
  },
  "welcomeStep3Text": {
    "message": "Save important links in sections, write notes and keep a to-do list for every workspace. Alt+S opens the side panel."
  },
  "welcomeStep4Title": {
    "message": "Save memory"
  },
  "welcomeStep4Text": {
    "message": "Restored tabs load on demand and inactive tabs can be suspended automatically. Configure it in Settings."
  },
  "welcomeFootnote": {
    "message": "Tip: pin the extension to the toolbar so the switcher is one click away."
  }
